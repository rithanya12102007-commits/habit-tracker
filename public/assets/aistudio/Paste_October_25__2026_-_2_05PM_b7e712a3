      const samples: number[][] = [];
      for (let i = 0; i < MAX_TRIES && samples.length < SAMPLES_NEEDED; i++) {
        const face = await readFace(videoRef.current!);
        if (face) {
          samples.push(face);
          setMessage(`Captured ${samples.length} of ${SAMPLES_NEEDED}. Keep still, slightly move your head...`);
        }
        await wait(900);
      }

      if (samples.length < SAMPLES_NEEDED) {
        setMessage('Could not see your face clearly. Try again in better light.');
      } else {
        saveFace(uid, samples);
        setFaceUnlocked(uid);
        setEnabled(true);
        setMessage('');
      }
    } catch (err) {
      setMessage(cameraErrorMessage(err));
    } finally {
      stopCamera(streamRef.current);
      streamRef.current = null;
      setScanning(false);
    }
  };

  const turnOff = () => {
    removeFace(uid);
    setEnabled(false);
    setMessage('');
  };

  return (
    <div className="p-6 rounded-2xl bg-[#121422] border border-neutral-800 space-y-4">
      <h2 className="text-sm font-bold text-white flex items-center gap-2">
        <ScanFace className="w-4 h-4 text-violet-400" />
        <span>Face Unlock</span>
      </h2>

      <p className="text-xs text-neutral-400 leading-relaxed">
        Lock Ritho AI on this device and open it with your face. Your face data stays on this device only. It is
        never uploaded. Your password still protects your account, and a photo of you may be able to fool face
        unlock, so treat it as a convenience lock.
      </p>

      <div className={scanning ? 'block' : 'hidden'}>
        <div className="mx-auto w-48 h-48 rounded-full overflow-hidden border-4 border-violet-500/60 bg-black">
          <video ref={videoRef} muted playsInline className="w-full h-full object-cover -scale-x-100" />
        </div>
      </div>

      {message && <p className="text-xs text-neutral-300">{message}</p>}

      {isDemoUser ? (
        <p className="text-xs text-neutral-500">Not available in Demo Mode.</p>
      ) : enabled ? (
        <div className="flex items-center justify-between gap-3 flex-wrap">
          <span className="text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
            <CheckCircle2 className="w-4 h-4" /> Face Unlock is ON for this device
          </span>
          <button
            type="button"
            onClick={turnOff}
            className="px-3 py-2 rounded-xl bg-[#181a29] hover:bg-[#1f2233] border border-neutral-800 text-xs font-semibold text-white flex items-center gap-1.5"
          >
            <Trash2 className="w-3.5 h-3.5 text-red-400" /> Turn off and delete my face
          </button>
        </div>
      ) : (
        <button
          type="button"
          onClick={setup}
          disabled={scanning}
          className="px-4 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 disabled:opacity-60 text-white text-xs font-semibold"
        >
          {scanning ? 'Scanning...' : 'Set up Face Unlock'}
        </button>
      )}
    </div>
  );
};

